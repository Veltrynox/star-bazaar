      "FC_STATUS_<STATUS>",
      "GIG_REFUSE_<REASON>",
      "BOT_NAME_<n>"
    ],
    "behaviour_changes_in_english": [
      "LBL_SKILL_POINTS_HELP now reads the point values from balance (skill_points_planet/route/system); the old literal said 1, 2, 3 but balance is 2, 1, 4.",
      "GOAL_SECOND_LANE: system number is the {sys} placeholder.",
      "GIG_REFUSE_*: the refusal now shows a written reason (busy, bad_target, no_gate, no_offer) instead of the raw code; generic text keeps {why}.",
      "Markets.name_of(id) added (reads SK_TAB_MIL etc.), replaces Markets.names lookups in chains.gd, events.gd, main.gd.",
      "Workshops.why_text(why) added: translates the internal stalled reasons at display time; the internal keys ('needs x', 'storage full') are unchanged."
    ],
    "not_converted": [
      "game/debug_menu.gd and main.gd 'Debug: points added' (debug only).",
      "Planet names, planet desc, and any text in data/*.json that is not an id (planets.json name/desc): data, not code.",
      "Language names 'English' and 'Русский' in main_menu.gd (a language picker shows each language in its own name).",
      "Key hints ' (Esc)', ' (Space)', ' (M)', ' (J)', '(B)' appended to tooltips (key names, not words).",
      "Internal state keys: route 'status' words, workshop reason keys, 'no core' reason in main.gd (never shown as is), events.gd regex words.",
      "game/traffic_layer.gd debug stats line; qa/ and tools/ scripts.",
      "Number-only formats ('%d / %d', '%+d', '%dx') and recipe lines 'N good + N good -> N good' (good names come from ids, arrow is a symbol).",
      "TUT_FALLBACK table in main.gd and other fallbacks of ids that already exist (kept as English fallback)."
    ],
    "tests": "sh tools/tests/run.sh: pass=12017 fail=13, the known 13 only. New checks: story ids in code (2)."
  }
