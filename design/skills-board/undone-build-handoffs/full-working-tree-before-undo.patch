+## LUX_8: share of bot b (b = 0: the player) in market m after `ahead` more cycles. Bots run the real Bots.volume with their stored gap and hits;
+## the player keeps the average of the last three cycles. Pure projection, nothing is stored.
+static func projected_share(b: int, m: String, ahead: int) -> float:
+	_ensure()
+	var w := window_for(m)
+	var pv: Array = vp.get(m, []).duplicate()
+	var rows: Array = vb.get(m, []).duplicate(true)
+	var avg := 0.0
+	var n := mini(3, pv.size())
+	for i in n:
+		avg += float(pv[pv.size() - 1 - i])
+	avg = avg / maxf(1.0, float(n))
+	for a in range(1, ahead + 1):
+		var cyc := cycles + a
+		var row := []
+		for bb in Bots.IDS:
+			var md := bot_mods(bb, m, cyc)
+			row.append(Bots.volume(bal, run_seed, bb, m, cyc, float(gap.get("%d|%s" % [bb, m], 0.0)), int(tier_off.get(str(bb), 0)) + int(md["tier_offset"]),
+				float(md["strength_mult"]) * Skills.bot_strength_mult(m), float(md["growth_mult"]) * Skills.bot_growth_mult(m), float(md["growth_add"])))
+		rows.append(row)
+		pv.append(avg)
+	var total := _sum_window(pv, w)
+	var mine := total
+	for bb in Bots.IDS:
+		total += _sum_window(rows, w, bb - 1)
+	if total <= 0.0:
+		return 0.0
+	return (mine if b == 0 else _sum_window(rows, w, b - 1)) / total
+
