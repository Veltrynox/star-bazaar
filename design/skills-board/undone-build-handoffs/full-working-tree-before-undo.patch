index 097eca8..9c9d4a4 100644
--- a/game/clusters.gd
+++ b/game/clusters.gd
@@ -49,7 +49,7 @@ func setup(bal: Dictionary) -> void:
 		if int(taken.get(sid, 0)) >= cap:
 			continue
 		taken[sid] = int(taken.get(sid, 0)) + 1
-		var rich := int(balance.get("mining_cluster_richness", 0))
+		var rich := roundi(float(balance.get("mining_cluster_richness", 0)) * Skills.cluster_richness_mult())
 		items.append({"id": str(d["id"]), "system": sid, "x": float(d.get("x", 0)), "y": float(d.get("y", 0)),
 			"radius": float(d.get("radius", 40)), "count": int(d.get("count", 1)), "good": str(d.get("good", default_good)),
 			"max": rich, "left": rich, "spawned": false})
@@ -72,6 +72,16 @@ func good_of(i: int) -> String:
 func system_of(i: int) -> int:
 	return int(items[i]["system"]) if valid(i) else 1
 
+## MIN_15: raises every original cluster to base richness x Skills.cluster_richness_mult(); ore already mined stays mined
+## (the difference is added to what is left). Event clusters (spawned) keep their own size.
+func sync_richness() -> void:
+	var target := roundi(float(balance.get("mining_cluster_richness", 0)) * Skills.cluster_richness_mult())
+	for it in items:
+		if bool(it.get("spawned", false)) or int(it["max"]) >= target:
+			continue
+		it["left"] = int(it["left"]) + target - int(it["max"])
+		it["max"] = target
+
 ## Units one cluster gives per cycle, shared by every ship on it (mining_yield_per_cycle).
 func yield_per_cycle() -> int:
 	return floori(float(balance.get("mining_yield_per_cycle", 0)) * Skills.cluster_yield_mult())
