 "source": "2026-11-06 skills-fill (economy-designer, owner order): 35 nodes added (3 FND, 8 per market) using existing effect types only; see handoffs/economy-designer/2026-11-06-skills-fill.json. 2026-11-05 skill-tree-final (economy-designer, agreed with feature-designer and qa-analyst): see design/proposals/2026-11-05-skill-tree-final.md. Filler percent effects removed; MIL_2 batches, MIL_3 debris immunity, LUX_6 batch yield, BIO_3 growth ceiling.",
 "vocabulary": {
  "_how": "effect = {type, target, ...}. Numbers are never stored here: key / duration_key / cooldown_key / cap_key name a data/balance.json value. cost 0 = tech node (researched by crafting; goal = balance[tech_goal_key] units made by that market's workshop(s), counted from when prereqs are met). cost is also in balance skill_cost_<id> (balance is authoritative). 'extra' = more effects applied with the same node. prereqs: all listed ids must be learned/researched. target: market id (mil|lux|min|bio), 'all', 'ships', 'planet_storage', 'feature', 'workshop', 'good'.",
  "types": {
   "upkeep_mult": "ship upkeep (trip cost and maintenance) x (1 - balance[key])",
   "volume_pct": "share volume of target market x (1 + balance[key]); optional condition 'sale_at_price_up_planet' = only sales at a planet with a price-up event",
   "route_capacity_pct": "units per cycle on routes carrying target-market goods x (1 + balance[key])",
   "sale_price_pct": "sale price of target-market goods x (1 + balance[key]); cash only, share_effect false = share still uses base values",
   "event_cut_pct": "price/damage events against the player in target market reduced by balance[key] (0.5 = half)",
   "event_bonus_pct": "price-up events in target market pay + balance[key] of their pct (0.5 = +50%)",
   "storage_cap_pct": "capacity of target (planet storage) x (1 + balance[key])",
   "order_size_pct": "Buy and Sell order amount x (1 + balance[key])",
   "workshop_batches": "workshop batches per cycle in target market + balance[key]",
   "batch_yield": "units out of each batch in target market + balance[key]",
   "unlock": "unlocks target kind id: workshop (smelter|munitions|atelier|culture_lab|fabric), good (goods.json id), feature (space_storage|permit_routes|cluster_routes)",
   "bot_strength_pct": "bot strength in target market down balance[key]. shared_cooldown_key (T173 r2): every chosen_bot hit, of any market, also locks all chosen_bot skills for balance[shared_cooldown_key] cycles after it starts (one pressure action per window). pick chosen_bot = player chooses one bot; all_bots = every bot. duration_key = cycles it lasts; cooldown_key = cycles between uses; once_per_run; permanent = rest of run",
   "bot_growth_mult": "bot growth in target market x balance[key]; pick all_bots; permanent",
   "share_window": "share window of target market = balance[key] cycles instead of share_window",
   "reveal_prices": "next-cycle prices shown for 'cycles' cycles ahead",
   "event_warning": "next event announced 'cycles' cycles early",
   "mine_unlock": "allows mining good id at place (planet id)",
   "cluster_yield_pct": "mining yield per cluster x (1 + balance[key])",
   "stock_growth_pct": "stock held in where (planet_storage) of target market grows balance[key] per cycle, up to balance[cap_key] of the stored amount",
   "stock_protect": "stored target-market stock is not trimmed when an asteroid hit cuts a planet storage (on storage_cut)",
   "ore_free_slots": "ore Buy and Sell orders ignore the order-size cap (limited by storage room, cash and stock)",
   "reopen_sooner": "a closed planet reopens 'cycles' cycles sooner",
   "event_immune": "routes carrying target-market goods ignore route events of the listed kinds (kinds: debris). Pirates have no live source, so no pirate kind.",
   "stock_growth_cap": "raises the cap of the stock_growth_pct effect for target market to balance[cap_key] (BIO_3 lifts the BIO_2 ceiling)"
  }
 },
